# Cách 1: điền tay (lấy từ Supabase Dashboard -> Settings -> API, giống secrets.toml của app gốc)
SUPABASE_URL=
SUPABASE_KEY=

# Cách 2: nếu dùng tích hợp Vercel Marketplace x Supabase ("Connect an existing project"), Vercel
# tự bơm 2 biến dưới đây — không cần điền tay ở trên nữa, code tự nhận cả 2 cách (xem
# src/lib/supabase.ts). Ghi ở đây chỉ để tham khảo, KHÔNG cần đặt local nếu chạy local bằng cách 1.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Tuỳ chọn — bật cổng đăng nhập bằng Google (chỉ 1 tài khoản được vào app), giống mục [auth] +
# ALLOWED_EMAIL của secrets.toml.example ở app gốc. Thiếu GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET
# thì app chạy KHÔNG có cổng đăng nhập (giữ hành vi cũ). Đã điền 2 biến đó thì BẮT BUỘC phải có
# ALLOWED_EMAIL và AUTH_COOKIE_SECRET, thiếu sẽ báo lỗi cấu hình khi mở app.
#
# Tạo OAuth Client ID tại console.cloud.google.com -> APIs & Services -> Credentials -> OAuth
# client ID (Web application), Authorized redirect URI = <domain-app-của-bạn>/api/auth/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_EMAIL=ban@gmail.com

# Chuỗi ngẫu nhiên tự nghĩ ra, dùng để ký session cookie (HMAC) — đổi giá trị này sẽ đăng xuất
# toàn bộ session đang có. Có thể tạo nhanh bằng: openssl rand -base64 32
# AUTH_COOKIE_SECRET=
